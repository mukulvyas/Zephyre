# =====================================================
# Zephyre Air Quality Coach - Environment Configuration
# =====================================================

# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Google Gemini API (optional - app falls back to rule-based templates if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# WAQI (World Air Quality Index) API Token (optional - falls back to Open-Meteo)
WAQI_TOKEN=

# Demo Mode (forces fixed test AQI profiles for reproducible demos/testing)
DEMO_MODE=false
DEMO_AQI_CITY=

# Rate Limiting & Cache
RATE_LIMIT_PER_MINUTE=60
CACHE_TTL_AQI_SECONDS=900
CACHE_TTL_GEOCODING_SECONDS=86400

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:8000
